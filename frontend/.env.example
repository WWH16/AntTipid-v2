# Copy to .env.local (gitignored). On Vercel, set these under Settings > Environment Variables instead.
# Supabase project URL and anon (or publishable) key, from Dashboard > Project Settings > API Keys.
# Safe to ship to the browser; used only for sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Default /api goes through the Vite dev proxy to http://localhost:8000. Set a full URL only for a deployed API.
# VITE_API_URL=/api
