# Copy to .env.local (gitignored). On Vercel, set these under Settings > Environment Variables instead.
# false = real backend + Supabase sign-in (the normal setting). true = in-memory sample data for offline UI work;
# receipt scanning still calls the backend in mock mode, so run it for scans (see backend/README.md).
VITE_USE_MOCK=false
# Supabase project URL and anon (or publishable) key, from Dashboard > Project Settings > API Keys.
# Safe to ship to the browser; used only for sign-in. Not needed in mock mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Default /api goes through the Vite dev proxy to http://localhost:8000. Set a full URL only for a deployed API.
# VITE_API_URL=/api
