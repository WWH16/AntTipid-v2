# Leave VITE_USE_MOCK unset (or true) to run on mock data. Set to false once the FastAPI server is up.
# Receipt scanning always calls the backend, so run it for scans even in mock mode (see backend/README.md).
VITE_USE_MOCK=true
# Default /api goes through the Vite dev proxy to http://localhost:8000. Set a full URL only for a deployed API.
# VITE_API_URL=/api
