# Copy to .env (gitignored). On Vercel, set these under Settings > Environment Variables instead.
# Never commit real values.

# --- Receipt reading. OpenRouter free models are tried first; Gemini is the fallback. Either key alone works.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Supabase (Dashboard > Project Settings)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Anon (or publishable, sb_publishable_...) key. Sent with the user's token to Storage for receipt photos.
SUPABASE_ANON_KEY=
# Transaction pooler connection string (Connect > Transaction pooler, port 6543), with the database password:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Legacy JWT secret (Settings > JWT Keys > Legacy JWT secret). Only needed if the project still signs
# tokens with HS256; with the newer signing keys tokens are checked against the project's JWKS instead.
SUPABASE_JWT_SECRET=

# Optional: whose "today" the reports use. Defaults to Asia/Manila.
# APP_TIMEZONE=Asia/Manila
